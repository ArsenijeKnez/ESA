{
  "info": {
    "name": "Toolshop API - Store Product",
    "_postman_id": "toolshop-store-product-collection",
    "description": "Collection with login and create-product requests plus tests for Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login - get auth token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["users", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login response is 2xx', function () {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "var json = {};",
              "try { json = pm.response.json(); } catch(e) { }",
              "var token = json.token || json.access_token || (json.data && json.data.token);",
              "if (token) {",
              "  pm.environment.set('authToken', token);",
              "  console.log('authToken set');",
              "} else {",
              "  console.warn('Auth token not found in response body');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Product - store new product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{productName}}\",\n  \"description\": \"Automated test product\",\n  \"price\": 9.99,\n  \"category_id\": \"{{categoryId}}\",\n  \"brand_id\": \"{{brandId}}\",\n  \"product_image_id\": \"{{productImageId}}\",\n  \"is_location_offer\": {{isLocationOffer}},\n  \"is_rental\": {{isRental}},\n  \"co2_rating\": \"{{co2Rating}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var name = 'Test Product ' + Date.now();",
              "pm.environment.set('productName', name);",
              "pm.environment.set('productSku', 'SKU-' + name);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 2xx', function () {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "var json = {};",
              "try { json = pm.response.json(); } catch(e) { }",
              "var id = json.id || (json.data && json.data.id) || json.product_id;",
              "pm.test('Response contains a product id', function () {",
              "  pm.expect(id).to.exist;",
              "});",
              "var returnedName = json.name || (json.data && json.data.name);",
              "pm.test('Returned name matches request', function () {",
              "  pm.expect(returnedName).to.eql(pm.environment.get('productName'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
